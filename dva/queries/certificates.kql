// Certificates expiring within the next 30 days, for the posture appendix (not scored).
DeviceTvmCertificateInfo
| extend Exp = todatetime(ExpirationDate)
| where Exp between (now() .. now() + 30d)
| summarize Devices = dcount(DeviceId), Sample = any(Path) by Thumbprint, FriendlyName, tostring(IssuedTo), Exp
| order by Exp asc
| take 200
