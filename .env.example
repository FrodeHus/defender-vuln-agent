# Single-tenant credentials. For several tenants use `dva tenant init NAME` and tenants/NAME/.env instead.
# Values exported in your shell take precedence over this file. Never commit .env.
DVA_TENANT_ID=
DVA_CLIENT_ID=
DVA_CLIENT_SECRET=
# Certificate instead of a secret:
# DVA_CLIENT_CERT_PATH=
# DVA_CLIENT_CERT_THUMBPRINT=
# Friendly name shown in reports:
# DVA_TENANT_NAME=
# Optional paths:
# DVA_RUNS_DIR=runs
# DVA_CACHE_DIR=.cache
